# Copy to .env to override defaults. Read by docker compose and the Makefile.
POSTGRES_USER=channelpulse
POSTGRES_PASSWORD=channelpulse
POSTGRES_DB=channelpulse
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000

# Least-privilege roles the API uses (created by `make roles`): the agent reads marts only; ops writes traces only.
AGENT_DB_PASSWORD=channelpulse_agent
OPS_DB_PASSWORD=channelpulse_ops

# Model calls are opt-in. The Ask page answers live only with ASK_LIVE=1 AND a configured provider; otherwise it
# replays the answers recorded by the last full eval run (decisions D29). Keys and URLs live only in this file.
# ASK_LIVE=1

# Which provider answers (decisions D31): gemini (default), ollama or anthropic. Temperature 0 unless set.
# CHANNELPULSE_PROVIDER=gemini
# CHANNELPULSE_TEMPERATURE=0

# Gemini API (free tier: Google may use prompts to improve its products; every row here is synthetic).
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=15                   # the key's free-tier quota; the eval throttles to 80%
# GEMINI_TPM=250000
# GEMINI_RPD=500
# GEMINI_REASONING_EFFORT=low

# A self-hosted Ollama server, e.g. behind a tunnel. The URL is a secret: never commit, log or print it.
# OLLAMA_BASE_URL=https://...
# OLLAMA_MODEL=...
# OLLAMA_API_TOKEN=...            # only if an auth proxy sits in front
# OLLAMA_QUANTIZATION=Q4_K_M      # recorded with eval runs, not sent
# OLLAMA_CONTEXT=65536            # recorded with eval runs, not sent
# OLLAMA_THINKING=off             # recorded with eval runs; OLLAMA_REASONING_EFFORT is what's sent
# OLLAMA_REASONING_EFFORT=none

# Anthropic (paid; `make eval` asks before it spends). Leave the key commented out rather than empty: an empty key
# still counts as "set" and would shadow an `ant auth login` profile.
# CHANNELPULSE_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
