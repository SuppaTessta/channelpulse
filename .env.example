# Copy to .env to override defaults. Read by docker compose and the Makefile.
POSTGRES_USER=channelpulse
POSTGRES_PASSWORD=channelpulse
POSTGRES_DB=channelpulse
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000

# Least-privilege roles the API uses (created by `make roles`): the agent reads marts only; ops writes traces only.
AGENT_DB_PASSWORD=channelpulse_agent
OPS_DB_PASSWORD=channelpulse_ops

# Model calls are opt-in and paid. The Ask page answers live only with ASK_LIVE=1 AND an Anthropic key; otherwise it
# replays the answers recorded by the last full eval run (decisions D29). Keys live only in this file.
# ASK_LIVE=1

# Anthropic (`make eval` asks before it spends). Leave the key commented out rather than empty: an empty key still
# counts as "set" and would shadow an `ant auth login` profile. Sonnet 5.5 by default; Haiku 5.5 is the eval's
# comparison model (decisions D50).
# ANTHROPIC_API_KEY=sk-ant-...
# CHANNELPULSE_MODEL=claude-sonnet-5-5
# CHANNELPULSE_EFFORT=medium
