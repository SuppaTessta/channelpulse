# Copy to .env to override defaults. Read by docker compose and the Makefile.
POSTGRES_USER=channelpulse
POSTGRES_PASSWORD=channelpulse
POSTGRES_DB=channelpulse
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000

# Least-privilege roles the API uses (created by `make roles`): the agent reads marts only; ops writes traces only.
AGENT_DB_PASSWORD=channelpulse_agent
OPS_DB_PASSWORD=channelpulse_ops

# Paid model calls are opt-in. The Ask page answers live only with ASK_LIVE=1 AND a key; otherwise it replays the
# answers recorded by the last full eval run (decisions D29). `make eval` asks before it spends.
# ASK_LIVE=1
# CHANNELPULSE_MODEL=claude-opus-5-5

# Needed only for the live Ask panel and `make eval`; everything else runs without it. Leave it commented out rather than
# empty: an empty key still counts as "set" and would shadow an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
